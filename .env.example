# Telegram bot token from @BotFather
TG_TOKEN=

# Only this chat id may trigger /deploy or receive scheduler alerts.
# Get it by messaging your bot once, then GET https://api.telegram.org/bot<TOKEN>/getUpdates
TG_CHAT_ID=

# Absolute path to the repo checkout on this laptop
REPO_DIR=

# Remote that carries release/YYYYMMDD branches
RELEASE_REMOTE=origin

# Remote to push phi-dev to after merge
PUSH_REMOTE=ups

# Extra args appended to `dotnet ef database update`, space-separated.
# No quoting support — paths here must not contain spaces.
# e.g. --project src/Phi.Data --startup-project src/Phi.Api
EF_ARGS=

# Preferred VPN check: the IPv4 prefix your VPN hands out (find it with
# `ipconfig`/`ifconfig` while connected), e.g. "10.151.". Works identically on
# macOS and Windows regardless of adapter naming. Leave blank to fall back to
# VPN_IFACE_PATTERN below.
VPN_SUBNET_PREFIX=

# Fallback: regex (case-insensitive, anchored) matched against interface
# names, IPv4-only. Default covers common macOS (utun) and Windows
# (tap/ppp/wg) VPN adapters — but many corporate clients (AnyConnect,
# FortiClient, GlobalProtect) use a friendly Windows adapter name instead, so
# VPN_SUBNET_PREFIX is the more reliable option if you have one.
VPN_IFACE_PATTERN=^(utun|tun|wg|ppp|tap)

# URL pinged (HEAD) every scheduler tick to confirm real internet connectivity
INTERNET_CHECK_URL=https://api.telegram.org
