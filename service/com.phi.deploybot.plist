<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.phi.deploybot</string>
  <key>ProgramArguments</key>
  <array>
    <!-- /usr/bin/env + PATH below finds node whether it's Homebrew Intel
         (/usr/local/bin) or Apple Silicon (/opt/homebrew/bin) -->
    <string>/usr/bin/env</string>
    <string>node</string>
    <!-- edit to the absolute path of this repo -->
    <string>/absolute/path/to/phirelease/index.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/absolute/path/to/phirelease</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd's default PATH is /usr/bin:/bin:/usr/sbin:/sbin, which has
         neither node nor dotnet nor the dotnet-ef global tool -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/local/share/dotnet:/usr/bin:/bin:/usr/sbin:/sbin:/Users/YOUR_USER/.dotnet/tools</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/phirelease-deploybot.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/phirelease-deploybot.log</string>
</dict>
</plist>
